# Speech Bridge — ignore rules.
# Patterns are anchored (leading /) so they never touch vendored trees in
# third_party/, which are committed whole.

# --- build outputs -----------------------------------------------------
/build/
/lib/
/app/sb-server

# --- model weights ---------------------------------------------------
# Fetched + sha256-verified by scripts/fetch-models.sh. Multi-GB, never committed.
# Only models/MANIFEST.md is tracked.
/models/*
!/models/MANIFEST.md

# --- scratch --------------------------------------------------------
/temp/
*.part
/models/.extract.*

# --- Go ------------------------------------------------------------
/app/vendor/
*.test

# --- frontend --------------------------------------------------------
# web/dist/ is NOT ignored: it's go:embed'd by web/web.go, so a committed
# build must exist for `go build` to work without node. `make web` /
# scripts/build.sh regenerate it in place when node is available; commit the
# refreshed dist/ alongside frontend source changes. See web/frontend/README.md.
/web/frontend/node_modules/

# --- Claude Code / editors / OS ---------------------------------
.claude/settings.local.json
.DS_Store
*.swp
*~
.idea/
.vscode/

# stray `go build ./app/cmd/X` outputs land in the repo root
/gguf-kv
/sb-bench
/sb-server
