# Speech Bridge — ignore rules.
# Patterns are anchored (leading /) so they never touch vendored trees in
# third_party/, which are committed whole.

# --- build outputs -----------------------------------------------------
/build/
/lib/
/sb-server
/server/build/

# --- model weights ---------------------------------------------------
# Fetched + sha256-verified by scripts/fetch-models.sh. Multi-GB, never committed.
# Only models/MANIFEST.md is tracked.
/models/*
!/models/MANIFEST.md

# --- scratch --------------------------------------------------------
/temp/
*.part
/models/.extract.*

# --- frontend --------------------------------------------------------
# web/dist/ is NOT ignored: sb-server serves it straight off disk (see
# server/src/main.cpp), so a committed build must exist for a node-less host
# to ship a working frontend. `make web` / scripts/build.sh regenerate it in
# place when node is available; commit the refreshed dist/ alongside
# frontend source changes. See web/frontend/README.md.
/web/frontend/node_modules/

# --- Claude Code / editors / OS ---------------------------------
.claude/settings.local.json
.DS_Store
*.swp
*~
.idea/
.vscode/
